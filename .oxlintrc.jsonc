{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "import", "eslint"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/*.js",
    "**/*.mjs",
    "**/node_modules/**",
    "**/target/**",
    "**/coverage/**",
    "**/.next/**",
    "**/supabase/**",
    "**/dist/**",
    "**/public/**"
  ],
  "rules": {
    // --- Метрики коду та складність ---
    "max-lines": ["warn", {"max": 300}],
    "max-lines-per-function": ["warn", {"max": 170}],
    "max-params": "warn",
    "max-depth": ["warn", 3],

    // --- Базові правила JS/TS ---
    "no-nested-ternary": "warn",
    "eqeqeq": "error",
    "curly": ["error", "all"],
    "func-style": ["error", "declaration", {"allowArrowFunctions": true}],
    "func-names": ["error", "always"],
    "no-console": [
      "error",
      {"allow": ["table", "error", "warn", "time", "timeEnd"]}
    ],

    // --- Імпорти та невикористані змінні (заміна unused-imports) ---
    "no-restricted-imports": ["error", {"patterns": ["app/*", "node_modules"]}],
    "no-unused-vars": [
      "error",
      {
        "vars": "all",
        "varsIgnorePattern": "^_",
        "args": "all",
        "argsIgnorePattern": "^_"
      }
    ],

    // --- TypeScript правила (звичайні) ---
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-unnecessary-type-constraint": "warn",
    "@typescript-eslint/prefer-as-const": "error",
    "@typescript-eslint/explicit-function-return-type": [
      "warn",
      {"allowExpressions": true}
    ],
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-inferrable-types": "error",
    "@typescript-eslint/no-misused-new": "error",
    "@typescript-eslint/no-non-null-assertion": "error",

    // --- TypeScript правила з перевіркою типів (працюють через oxlint-tsgolint) ---
    "@typescript-eslint/no-unnecessary-type-assertion": "error",
    "@typescript-eslint/no-unnecessary-boolean-literal-compare": "warn",
    "@typescript-eslint/no-unnecessary-type-arguments": "error",
    "@typescript-eslint/prefer-includes": "warn",
    "@typescript-eslint/prefer-nullish-coalescing": "warn",
    "@typescript-eslint/prefer-optional-chain": "warn",
    "@typescript-eslint/prefer-string-starts-ends-with": "warn",
    "@typescript-eslint/no-for-in-array": "error",
    "@typescript-eslint/no-misused-promises": [
      "error",
      {"checksVoidReturn": false}
    ],
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/await-thenable": "error",

    // --- Сумісність з React 19 та @react-three/fiber ---
    "react/react-in-jsx-scope": "off",
    "react/no-unknown-property": "off",

    // --- Вимкнення правил React Compiler (конфліктують з Three.js / R3F та MobX) ---
    "react/immutability": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/void-use-memo": "off",
    "react/set-state-in-effect": "off",

    // --- Вимкнення занадто прискіпливих дефолтних правил Oxlint ---
    "@typescript-eslint/unbound-method": "off",
    "@typescript-eslint/no-useless-default-assignment": "off",
    "@typescript-eslint/no-redundant-type-constituents": "off"
  },
  "overrides": [
    {
      "files": ["**/*.tsx"],
      "rules": {
        "@typescript-eslint/explicit-function-return-type": "off",
        "max-lines-per-function": ["error", {"max": 1000}]
      }
    }
  ]
}
